# Backend
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# MySQL — database is created automatically on backend start
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=multi_doc

# Workbench login (backend only — never expose these to the frontend bundle)
LOGIN_USERNAME=analyst
LOGIN_PASSWORD=ChangeMe!2026
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Upload limits
MAX_FILES=5
MAX_FILE_BYTES=2097152

# Optional: set to openai to use OpenAI instead of the mock provider
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
